APP_ENV=development
# Each caller supplies their own cookie at login. No API key or server credentials.

# Live LinkedIn access is disabled unless explicitly enabled.
LINKEDIN_LIVE_ENABLED=false
# any allows any valid LinkedIn /in/<slug>/ URL, not arbitrary websites.
LINKEDIN_PROFILE_ACCESS=any
SAFETY_STATE_FILE=.state/safety.sqlite3

# API sessions live in memory, not in the SQLite file.
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=20
LOGIN_LIMIT_PER_MINUTE=5

# Profile/posts API calls per LinkedIn credential (shared across its login tokens).
RATE_LIMIT_PER_MINUTE=2
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=20
# Actual LinkedIn GETs per credential. A full profile can cost six; posts can cost two.
LINKEDIN_MIN_REQUEST_INTERVAL_SECONDS=2.0
LINKEDIN_MAX_REQUESTS_PER_HOUR=10
LINKEDIN_MAX_REQUESTS_PER_DAY=20
# Shared upstream budget across every caller.
LINKEDIN_GLOBAL_MAX_REQUESTS_PER_HOUR=60
LINKEDIN_GLOBAL_MAX_REQUESTS_PER_DAY=120
LINKEDIN_CIRCUIT_BREAKER_COOLDOWN_SECONDS=3600

# Transport defaults stay in settings.py: one concurrent GET, no retries, 20s timeout.
# SQLite stores only safety counters/cooldowns; Render Free storage is temporary.
